{
  "name": "@jeffrog-256k1/billing-memo",
  "version": "0.2.0",
  "description": "A local-first notebook for your developer stack's bills, renewals and monthly costs.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "node --experimental-strip-types scripts/test-browser.ts",
    "render:assets": "node scripts/render-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win --x64",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:reports": "node --experimental-strip-types scripts/test-reports.ts",
    "icon": "node scripts/create-icon.mjs",
    "test:packaged": "node scripts/test-packaged.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@types/node": "22.20.5",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "gifenc": "1.0.3",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "main": "desktop/main.mjs",
  "author": "Jungjae Lee",
  "homepage": "https://github.com/jeffrog-256k1/billing-memo"
}
