{
  "name": "@jeffrog-256k1/billing-memo",
  "version": "0.1.0",
  "description": "A local-first notebook for your developer stack's bills, renewals and monthly costs.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node --experimental-strip-types scripts/test-browser.ts",
    "render:assets": "node scripts/render-assets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "gifenc": "1.0.3",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
